# MongoDB Atlas connection string (local: mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ffos
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed web origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
PORT=8787

# Optional: reminder notifications. Generate with `npm run vapid-keys -w api`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push services (an https URL or mailto:); defaults to the first CORS origin.
# VAPID_SUBJECT=
