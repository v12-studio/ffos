# MongoDB Atlas connection string (local: mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ffos
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed web origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
PORT=8787
